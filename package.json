{
  "name": "sidenotebook",
  "private": true,
  "version": "0.1.0",
  "description": "Windows 7 Sticky Notes-inspired floating research note-taker & tab folder manager for Chromium",
  "type": "module",
  "scripts": {
    "build:ui": "vite build --config vite.config.ts",
    "build:content": "vite build --config vite.content.config.ts",
    "build": "tsc --noEmit && npm run build:ui && npm run build:content",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  }
}
